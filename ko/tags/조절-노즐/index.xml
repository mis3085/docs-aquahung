        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%a0%95%ec%9b%90%ec%9d%84-%ec%9c%84%ed%95%9c-%ed%98%81%ec%8b%a0%ec%a0%81%ec%9d%b8-%ec%a1%b0%ec%a0%88-%eb%85%b8%ec%a6%90-%ec%98%b5%ec%85%98&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
